# ---- PostgreSQL (Supabase free tier) ----
# Project Settings → Database → Connection string → "Session" mode
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ---- Neo4j AuraDB Free ----
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_me

# ---- Redis (Upstash free) ----
# Upstash → Database → Connect → redis-cli URL
REDIS_URL=rediss://default:xxxxx@xxxxx.upstash.io:6379

# ---- LLM: Groq (free 14k req/day) ----
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---- News APIs ----
GUARDIAN_API_KEY=
GNEWS_API_KEY=
NEWSAPI_KEY=
GEONAMES_USERNAME=

# ---- Auth ----
JWT_SECRET=change-me-in-prod-min-32-chars-please-1234
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ---- ML ----
MODEL_DIR=./backend/ml

# ---- Kafka substitute: Redis Streams ----
STREAM_RAW=stream:raw.news
STREAM_PROCESSED=stream:processed.events
STREAM_GROUP=chainpulse-nlp

# ---- Email alerts (optional) ----
# Gmail App Password: https://myaccount.google.com/apppasswords
ALERTS_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@chainpulse.local

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://chainpulse.pages.dev
ALLOW_SEED=1
